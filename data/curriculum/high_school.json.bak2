              "unit_quiz": [
                {
                  "difficulty": "Easy",
                  "question": "Which of these is a natural number?",
                  "options": {
                    "A": "-3",
                    "B": "0",
                    "C": "7",
                    "D": "-10"
                  },
                  "answer": "C"
                },
                {
                  "difficulty": "Easy",
                  "question": "What type of number is 0?",
                  "options": {
                    "A": "Natural number only",
                    "B": "Integer only",
                    "C": "Both natural and integer",
                    "D": "Neither natural nor integer"
                  },
                  "answer": "B"
                },
                {
                  "difficulty": "Easy",
                  "question": "Which fraction is equal to 0.5?",
                  "options": {
                    "A": "1/3",
                    "B": "1/2",
                    "C": "3/4",
                    "D": "2/5"
                  },
                  "answer": "B"
                },
                {
                  "difficulty": "Medium",
                  "question": "Which set includes all the numbers: -5, 0, 3, -1?",
                  "options": {
                    "A": "Natural numbers",
                    "B": "Whole numbers",
                    "C": "Integers",
                    "D": "Only positive numbers"
                  },
                  "answer": "C"
                },
                {
                  "difficulty": "Medium",
                  "question": "John has 8,000 RWF. He spends 3,500 RWF on books. Which integer represents his remaining money?",
                  "options": {
                    "A": "4,500",
                    "B": "-4,500",
                    "C": "11,500",
                    "D": "-3,500"
